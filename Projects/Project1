cafe_name = "The Cozy Corner"
tax_rate = 0.08
menu = {
    "green tea": 3.00,
    "matcha latte": 4.50,
    "mango matcha": 4.25,
    "strawberry matcha": 5.00,
    "blueberry muffin": 2.50,
    "sando egg": 5.25,
}
order = []
discount_code = ""
discount = 0.0
final_total = 0.0
total = 0.0
tax = 0.0

def greet(c_name, name):
    print(f"Welcome to {c_name}, {name}!")

customer_name = input("Could I get your name? ")
greet(cafe_name, customer_name)

def show_menu():
    print("Menu:")
    for item, price in menu.items():
        print(f"{item}: ${price:.2f}")

show_menu()

show_order = input("Would you like to place an order? (yes/no): ").strip().lower()

if show_order == "yes":
    while True:
        item = input("Enter the item you want to order (or type done to finish): ").strip().lower()
        if item == "done":
            break
        elif item in menu:
            order.append(item)
            print(f"{item} added to your order.")
        else:
            print("Sorry, we don't have that item. Please choose from the menu.")

if order:
    total = sum(menu[item] for item in order)
    tax = total * tax_rate
    final_total = total + tax
    print("\nYour Order:")
    for item in order:
        print(f"- {item}: ${menu[item]:.2f}")
    print(f"Subtotal: ${total:.2f}")
    print(f"Tax: ${tax:.2f}")
    print(f"Total: ${final_total:.2f}")
else:
    print("You did not order anything.")

get_discount = input("Do you have a discount code? (yes/no): ").strip().lower()

if get_discount == "yes":
    discount_code = input("Please enter your discount code: ").strip()
    if discount_code == "MATCHA10":
        discount = final_total * 0.10
        final_total -= discount
        print(f"Discount applied: -${discount:.2f}")
        print(f"New Total: ${final_total:.2f}")
    else:
        print("Invalid discount code.")

print_receipt = input("Would you like a receipt? (yes/no): ").strip().lower()

if print_receipt == "yes":
    print("\nReceipt:")
    for item in order:
        print(f"- {item}: ${menu[item]:.2f}")
    print(f"Subtotal: ${total:.2f}")
    print(f"Tax: ${tax:.2f}")
    if get_discount == "yes" and discount_code == "MATCHA10":
        print(f"Discount: -${discount:.2f}")
    print(f"Total: ${final_total:.2f}")
